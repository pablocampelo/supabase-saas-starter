# Browser-safe. Set at build time; rebuild after changes. HTTPS except loopback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Use the project's sb_publishable_ key, never a service-role or sb_secret_ key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Replace with your support inbox before publication.
SUPPORT_EMAIL=support@example.com

# Reserved for privileged server operations that are not implemented in the current foundation.
SUPABASE_SECRET_KEY=

# Stripe billing is not implemented yet. Keep staging/test and production/live keys separate.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=

# Legacy Phase 0 catalog inputs kept temporarily because current code still validates them.
# Scope 2.0 makes Stripe Price authoritative for amount/currency/recurrence.
# Do not build new behavior around these variables; remove them when billing/catalog is reconciled.
PRO_MONTHLY_AMOUNT=
PRO_ANNUAL_AMOUNT=

# Supported Auth surface: Google OAuth + email/password verification/recovery only.
# Configure Resend SMTP, sender/domain, email templates, Google OAuth and allowed redirect URLs in Supabase.
# SMTP and Google client secrets do not belong in the app's browser-visible environment.
# Magic-link authentication is not supported.
# No real provider credentials are needed for unit tests or the isolated browser smoke test.
