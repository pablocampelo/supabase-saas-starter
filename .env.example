# Browser-safe. Set at build time; rebuild after changes. HTTPS except loopback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Use the project's sb_publishable_ key, never a service-role or sb_secret_ key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Replace with your support inbox before publication.
SUPPORT_EMAIL=support@example.com

# Reserved for later privileged server operations; not required by Phase 0.
SUPABASE_SECRET_KEY=
# Reserved for Phase 2. Keep staging/test and production/live keys separate.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
# Positive integer minor units in config/product.ts currency. No fallback prices.
PRO_MONTHLY_AMOUNT=
PRO_ANNUAL_AMOUNT=

# Configure Auth SMTP, sender/domain, email confirmation and allowed redirect URLs
# in Supabase when implementing Phase 1. SMTP credentials do not belong in the app.
# No real credentials are needed for unit tests or the isolated browser smoke test.
