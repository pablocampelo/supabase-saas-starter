# Browser-safe. Set at build time; rebuild after changes. HTTPS except loopback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Use the project's sb_publishable_ key, never a service-role or sb_secret_ key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Replace with your support inbox before publication.
SUPPORT_EMAIL=support@example.com

# Required for server-owned billing writes (webhooks/reconciliation). Never expose this key to the browser.
# Hosted projects should use an sb_secret_ key. Local Supabase may use the legacy service-role JWT printed by the CLI.
SUPABASE_SECRET_KEY=

# Stripe Billing. Keep staging/test and production/live credentials strictly separated.
# Price IDs select the only purchasable plans; Stripe Price remains authoritative for amount/currency/recurrence.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=

# Supported Auth surface: Google OAuth + email/password verification/recovery only.
# Each deployment owns its own Supabase project, Resend account/sending domain and provider credentials.
# Configure customer-owned Resend SMTP, sender/domain, email templates, Google OAuth and allowed redirect URLs in Supabase.
# SMTP and Google client secrets stay in provider configuration and do not belong in the app's browser-visible environment.
# Magic-link authentication is not supported.
# No real provider credentials are needed for unit tests or the isolated browser smoke test.
