{
  "name": "daysnotweeks-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "supabase:start": "pnpm dlx supabase@2.118.0 start",
    "supabase:stop": "pnpm dlx supabase@2.118.0 stop",
    "supabase:status": "pnpm dlx supabase@2.118.0 status",
    "supabase:db:reset": "pnpm dlx supabase@2.118.0 db reset",
    "supabase:test:db": "pnpm dlx supabase@2.118.0 test db",
    "supabase:types": "node scripts/generate-supabase-types.mjs",
    "billing:reconcile": "node --env-file-if-exists=.env.local scripts/reconcile-billing.mjs"
  },
  "dependencies": {
    "@fontsource-variable/funnel-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "stripe": "22.6.2",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
